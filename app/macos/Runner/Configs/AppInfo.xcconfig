// Application-level settings for the Flutter macOS target.
//
// PRODUCT_NAME is the Dock / menu-bar / .app name (tutuaword).
// The Xcode target stays "Runner" because Flutter and CocoaPods expect that.

PRODUCT_NAME = tutuaword

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.manasai.tutuaword

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 amit.blr76. All rights reserved.
